@media (max-width: 620px) {
    .shop-page .shop-shell,
    .shop-page .category-shell,
    .shop-page .product-shell {
        width: min(calc(100% - 24px), 1160px);
        padding-top: 18px;
        padding-bottom: 54px;
    }
}

.shop-page {
    --shop-panel: rgba(17, 24, 29, 0.85);
    --shop-panel-strong: rgba(19, 28, 34, 0.96);
    --shop-text: #edf3f5;
    --shop-muted: #8ba1a9;
    --shop-border: rgba(214,179,112,0.16);
    --shop-accent: #d6b370;
    background: linear-gradient(180deg, #0d1419, #0c1419 38%, #0f171c 100%);
    color: var(--shop-text);
}

.shop-page .shop-shell,
.shop-page .category-shell,
.shop-page .product-shell {
    width: min(1220px, calc(100% - 56px));
    margin-inline: auto;
    padding-block: 32px 90px;
}

.shop-page .shop-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 18px;
    align-items: center;
    min-height: 500px;
    margin-bottom: 52px;
    padding: clamp(26px, 4vw, 58px);
    border: 1px solid var(--shop-border);
    border-radius: 32px;
    background:
        radial-gradient(circle at top right, rgba(214,179,112,0.12), transparent 28%),
        linear-gradient(135deg, rgba(20,28,33,1), rgba(12,18,22,1));
    box-shadow: var(--ba-shadow-soft);
}

.shop-page .shop-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
}

.shop-page .shop-kicker,
.shop-page .product-eyebrow {
    color: var(--ba-accent-strong);
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
}

.shop-page .shop-hero h1,
.shop-page .category-intro h1,
.shop-page .product-info h1 {
    color: #f2efe7;
    letter-spacing: -0.05em;
}

.shop-page .shop-hero h1 {
    max-width: 600px;
    font-size: clamp(40px, 5vw, 72px);
    line-height: .92;
}

.shop-page .shop-hero p,
.shop-page .category-intro p,
.shop-page .product-short {
    max-width: 560px;
    color: var(--ba-text-soft);
    font-size: 15px;
    line-height: 1.9;
}

.shop-page .shop-hero__cta {
    align-self: flex-start;
    margin-top: 10px;
}

.shop-page .shop-hero__visual {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    border-radius: 26px;
    border: 1px solid var(--shop-border);
    background: linear-gradient(180deg, rgba(15,22,27,1), rgba(8,12,16,1));
}

.shop-page .shop-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.06);
}

.shop-page .shop-hero__label {
    position: absolute;
    left: 24px;
    bottom: 22px;
    padding: 8px 12px;
    border: 1px solid rgba(214,179,112,0.25);
    border-radius: 999px;
    background: rgba(12,17,20,0.7);
    color: var(--ba-accent-strong);
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.shop-page .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 23px;
    margin-bottom: 24px;
}

.shop-page .section-head h2 {
    color: #edf3f5;
    font-size: clamp(28px, 2.2vw, 38px);
    line-height: 1.2;
}

.shop-page .section-count {
    color: var(--ba-muted);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.shop-page .shop-filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid var(--shop-border);
    border-radius: 999px;
    background: rgba(18,29,35,0.72);
    color: var(--shop-text);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .shop-filter-trigger[aria-expanded="true"],
.shop-page .shop-filter-trigger:hover {
    border-color: rgba(214,179,112,0.4);
    background: rgba(214,179,112,0.08);
}

.shop-page .shop-filter-panel {
    margin-bottom: 22px;
    padding: 18px;
    border: 1px solid var(--shop-border);
    border-radius: 22px;
    background: rgba(16, 24, 29, 0.82);
    box-shadow: var(--ba-shadow-soft);
}

.shop-page .shop-filter-panel__top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
}

.shop-page .shop-filter-panel__top strong {
    display: block;
    color: #edf3f5;
    font-size: 16px;
}

.shop-page .shop-filter-panel__top span {
    display: block;
    margin-top: 4px;
    color: var(--ba-muted);
    font-size: 11px;
}

.shop-page .shop-filter-clear {
    color: var(--ba-accent-strong);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .shop-filter-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.shop-page .shop-filter-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.shop-page .shop-filter-field span {
    color: var(--ba-text-soft);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .shop-filter-field select,
.shop-page .shop-filter-field input {
    min-height: 46px;
    border: 1px solid var(--shop-border);
    border-radius: 12px;
    background: rgba(10,15,18,0.9);
    color: #edf3f5;
    padding: 0 12px;
    outline: none;
}

.shop-page .shop-filter-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 22px;
    margin-top: 18px;
    color: var(--ba-text-soft);
    font-size: 12px;
}

.shop-page .shop-filter-submit {
    margin-top: 18px;
    min-height: 44px;
    padding-inline: 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--ba-accent), #f1dba3);
    color: #121312;
    font-weight: 800;
}

.shop-page .products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 20px;
}

.shop-page .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--shop-border);
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(18,29,35,0.98), rgba(10,14,18,1));
    box-shadow: var(--ba-shadow-soft);
    transition: transform var(--ba-transition), border-color var(--ba-transition), box-shadow var(--ba-transition);
}

.shop-page .product-card:hover {
    transform: translateY(-6px);
    border-color: rgba(214,179,112,0.4);
    box-shadow: var(--ba-shadow-md);
}

.shop-page .product-card__media {
    position: relative;
    height: 300px;
    overflow: hidden;
    background: rgba(11,17,20,0.8);
}

.shop-page .product-card__gallery,
.shop-page .product-card__slides,
.shop-page .product-card__slide {
    position: absolute;
    inset: 0;
}

.shop-page .product-card__slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity .55s var(--ba-ease), transform .7s var(--ba-ease);
    transform: scale(1.04);
}

.shop-page .product-card__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
}

.shop-page .product-card__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.shop-page .product-card__favorite-form {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
}

.shop-page .product-card__favorite {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.18);
    background: rgba(10,15,18,0.52);
    color: #fff;
    backdrop-filter: blur(10px);
}

.shop-page .product-card__favorite svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
}

.shop-page .product-card__favorite.is-active {
    background: rgba(214,179,112,0.18);
    color: var(--ba-accent-strong);
    border-color: rgba(214,179,112,0.42);
}

.shop-page .product-card__discount {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 2;
    min-height: 24px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(214,179,112,0.18);
    border: 1px solid rgba(214,179,112,0.25);
    color: var(--ba-accent-strong);
    font-size: 9px;
    font-weight: 800;
}

.shop-page .product-card__dots {
    position: absolute;
    left: 50%;
    bottom: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(8,12,15,0.54);
    transform: translateX(-50%);
}

.shop-page .product-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.42);
}

.shop-page .product-card__dot.is-active {
    width: 18px;
    border-radius: 999px;
    background: var(--ba-accent-strong);
}

.shop-page .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 16px 18px;
}

.shop-page .product-card__info {
    display: block;
}

.shop-page .product-card__name {
    margin-bottom: 8px;
    color: #edf3f5;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.5;
}

.shop-page .product-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
}

.shop-page .product-card__price {
    color: var(--ba-accent-strong);
    font-size: 16px;
    font-weight: 800;
}

.shop-page .product-card__price span,
.shop-page .product-card__price-row del {
    color: var(--ba-muted);
    font-size: 10px;
}

.shop-page .product-card__cart,
.shop-page .product-card__cart-form button {
    width: 100%;
    min-height: 42px;
    border-radius: 12px;
    border: 1px solid rgba(214,179,112,0.32);
    background: rgba(214,179,112,0.08);
    color: var(--ba-accent-strong);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .product-card__cart:hover,
.shop-page .product-card__cart-form button:hover {
    background: linear-gradient(135deg, var(--ba-accent), #f0d8a0);
    color: #121312;
}

.shop-page .product-shell {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.shop-page .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--ba-muted);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .breadcrumbs a {
    color: var(--ba-accent-strong);
}

.shop-page .category-intro {
    max-width: 760px;
}

.shop-page .category-intro h1 {
    font-size: clamp(34px, 4vw, 60px);
    line-height: 1.02;
    margin-top: 12px;
}

.shop-page .product-layout {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(360px, .96fr);
    gap: clamp(26px, 4vw, 52px);
    align-items: start;
}

.shop-page .product-gallery {
    position: sticky;
    top: 102px;
}

.shop-page .gallery-main {
    position: relative;
    aspect-ratio: 1 / 1.06;
    overflow: hidden;
    border: 1px solid var(--shop-border);
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(16,24,29,1), rgba(8,12,16,1));
}

.shop-page .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.shop-page .gallery-main__index {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-width: 46px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--shop-border);
    background: rgba(10,15,18,0.78);
    color: var(--ba-accent-strong);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.shop-page .product-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 12px;
    margin-top: 14px;
}

.shop-page .product-gallery__thumb {
    overflow: hidden;
    border: 1px solid var(--shop-border);
    border-radius: 16px;
    background: rgba(10,15,18,0.9);
    padding: 0;
}

.shop-page .product-gallery__thumb.is-active {
    border-color: rgba(214,179,112,0.5);
    box-shadow: 0 0 0 1px rgba(214,179,112,0.18);
}

.shop-page .product-gallery__thumb img {
    width: 100%;
    height: 102px;
    object-fit: cover;
}

.shop-page .product-info {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.shop-page .product-info h1 {
    font-size: clamp(30px, 3.3vw, 54px);
    line-height: 1.04;
}

.shop-page .product-price-box,
.shop-page .product-options,
.shop-page .product-benefits,
.shop-page .product-description,
.shop-page .next-step-card {
    border: 1px solid var(--shop-border);
    border-radius: 24px;
    background: rgba(17, 24, 29, 0.82);
}

.shop-page .product-price-box {
    padding: 20px 18px;
}

.shop-page .price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
}

.shop-page .price {
    color: var(--ba-accent-strong);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 800;
}

.shop-page .price-unit {
    color: var(--ba-muted);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.shop-page .product-options {
    padding: 18px;
}

.shop-page .stock-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(214,179,112,0.08);
    color: var(--ba-text-soft);
    font-size: 12px;
}

.shop-page .stock-summary strong {
    color: #fff;
}

.shop-page .option-group + .option-group {
    margin-top: 18px;
}

.shop-page .option-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
}

.shop-page .option-heading h2 {
    color: #edf3f5;
    font-size: 14px;
}

.shop-page .option-heading span {
    color: var(--ba-muted);
    font-size: 11px;
}

.shop-page .color-options,
.shop-page .size-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.shop-page .color-option,
.shop-page .size-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--shop-border);
    border-radius: 10px;
    background: rgba(9,13,17,0.8);
    color: var(--ba-text-soft);
}

.shop-page .color-option.is-selected,
.shop-page .size-option.is-selected {
    border-color: rgba(214,179,112,0.52);
    background: rgba(214,179,112,0.12);
    color: #fff;
}

.shop-page .size-option {
    min-width: 52px;
}

.shop-page .add-to-cart-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.shop-page .add-to-cart-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.shop-page .quantity-control {
    display: flex;
    align-items: center;
    border: 1px solid var(--shop-border);
    border-radius: 999px;
    background: rgba(10,15,18,0.9);
}

.shop-page .quantity-control button {
    width: 36px;
    height: 36px;
    background: transparent;
    color: var(--ba-accent-strong);
    font-size: 18px;
}

.shop-page .quantity-control input {
    width: 44px;
    text-align: center;
    background: transparent;
    border: 0;
    color: #fff;
}

.shop-page .add-to-cart-button {
    flex: 1;
    min-height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--ba-accent), #f1dba3);
    color: #121312;
    font-weight: 800;
}

.shop-page .product-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 12px;
    padding: 18px;
}

.shop-page .product-benefits > div {
    padding: 14px 12px;
    border-radius: 18px;
    background: rgba(214,179,112,0.06);
}

.shop-page .product-benefits__number {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--ba-accent-strong);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.shop-page .product-benefits strong {
    display: block;
    color: #edf3f5;
    margin-bottom: 6px;
}

.shop-page .product-benefits small {
    color: var(--ba-muted);
    line-height: 1.8;
}

.shop-page .product-description,
.shop-page .next-step-card {
    padding: 18px;
}

.shop-page .product-description h2,
.shop-page .next-step-card h2 {
    margin-bottom: 12px;
    color: #edf3f5;
    font-size: 22px;
}

.shop-page .product-description p,
.shop-page .next-step-card p {
    color: var(--ba-text-soft);
    line-height: 2;
}

.shop-page .next-step-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
}

.shop-page .next-step-card .product-eyebrow {
    display: inline-block;
    margin-bottom: 6px;
}

.shop-page .next-step-card .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    min-height: 48px;
    border-radius: 999px;
    border: 1px solid rgba(214,179,112,0.35);
    background: rgba(214,179,112,0.08);
    color: var(--ba-accent-strong);
    font-weight: 700;
}

@media (max-width: 980px) {
    .shop-page .products {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .shop-page .shop-filter-grid {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .shop-page .product-layout {
        grid-template-columns: 1fr;
    }

    .shop-page .product-gallery {
        position: static;
    }
}

@media (max-width: 620px) {
    .shop-page .shop-hero {
        grid-template-columns: 1fr;
        padding: 20px 18px;
    }

    .shop-page .products,
    .shop-page .shop-filter-grid,
    .shop-page .product-benefits {
        grid-template-columns: 1fr;
    }

    .shop-page .next-step-card {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    .shop-page .product-card,
    .shop-page .product-card__slide,
    .shop-page .shop-filter-trigger {
        transition: none !important;
    }
}
