:root {
    --ba-50: #e9dcc0;
    --ba-100: #d6b370;
    --ba-200: #c89e5a;
    --ba-300: #a9772d;
    --ba-400: #7b5921;
    --ba-500: #3a2d1d;

    --ba-bg: #0d1419;
    --ba-bg-deep: #090f14;
    --ba-surface: #121d23;
    --ba-surface-2: #15252d;
    --ba-surface-3: #1e2f39;
    --ba-panel: rgba(16, 24, 30, 0.85);
    --ba-text: #edf3f5;
    --ba-text-soft: #bfd0d5;
    --ba-muted: #87a0a9;
    --ba-border: rgba(214,179,112,0.18);
    --ba-border-strong: rgba(214,179,112,0.32);
    --ba-white-border: rgba(255,255,255,0.08);

    --ba-accent: #d6b370;
    --ba-accent-strong: #efdb9a;
    --ba-accent-weak: rgba(214,179,112,0.14);
    --ba-success: #79c29a;
    --ba-warning: #d1a95a;
    --ba-danger: #ea8d7f;

    --ba-container: 1280px;
    --ba-radius-sm: 10px;
    --ba-radius-md: 14px;
    --ba-radius-lg: 20px;
    --ba-radius-xl: 28px;

    --ba-shadow-soft: 0 14px 40px rgba(0,0,0,0.18);
    --ba-shadow-md: 0 22px 64px rgba(0,0,0,0.26);
    --ba-shadow-lg: 0 32px 90px rgba(0,0,0,0.38);

    --ba-font: "Vazirmatn", "IRANSansX", "Segoe UI", Tahoma, Arial, sans-serif;
    --ba-display: "Vazirmatn", "IRANSansX", "Segoe UI", Tahoma, Arial, sans-serif;
    --ba-latin: "Arial", "Helvetica Neue", sans-serif;

    --ba-ease: cubic-bezier(.22,.61,.36,1);
    --ba-transition: 220ms var(--ba-ease);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
}

body:not(.customizer-page) {
    min-height: 100vh;
    background:
        radial-gradient(circle at top, rgba(214,179,112,0.12), transparent 28%),
        radial-gradient(circle at bottom left, rgba(27,57,66,0.45), transparent 35%),
        var(--ba-bg);
    color: var(--ba-text);
    font-family: var(--ba-font);
    line-height: 1.7;
    overflow-x: hidden;
}

body:not(.customizer-page) main {
    background: transparent;
}

body:not(.customizer-page) a {
    color: inherit;
    text-decoration: none;
}

body:not(.customizer-page) button,
body:not(.customizer-page) input,
body:not(.customizer-page) select,
body:not(.customizer-page) textarea {
    font: inherit;
}

body:not(.customizer-page) img,
body:not(.customizer-page) svg {
    display: block;
    max-width: 100%;
}

body:not(.customizer-page) button {
    border: 0;
    cursor: pointer;
}

body:not(.customizer-page) .container,
body:not(.customizer-page) .shop-shell,
body:not(.customizer-page) .category-shell,
body:not(.customizer-page) .product-shell,
body:not(.customizer-page) .cart-shell {
    width: min(calc(100% - 48px), var(--ba-container));
    margin-inline: auto;
}

body:not(.customizer-page) .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: rgba(10,15,18,0.72);
    border-bottom: 1px solid var(--ba-border);
}

body:not(.customizer-page) .site-header__inner {
    width: min(calc(100% - 48px), var(--ba-container));
    min-height: 74px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 52px minmax(0,1fr) auto 210px;
    align-items: center;
    gap: 18px;
    direction: ltr;
}

body:not(.customizer-page) .site-logo {
    justify-self: start;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 5px;
    line-height: 1;
}

body:not(.customizer-page) .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 28px);
    direction: rtl;
}

body:not(.customizer-page) .site-nav a {
    position: relative;
    padding: 8px 0;
    color: var(--ba-text-soft);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color var(--ba-transition);
}

body:not(.customizer-page) .site-nav a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    transform: scaleX(0); 
    transform-origin: center;
    background: var(--ba-accent);
    transition: transform var(--ba-transition);
}

body:not(.customizer-page) .site-nav a:hover,
body:not(.customizer-page) .site-nav a:focus-visible {
    color: #fff;
}

body:not(.customizer-page) .site-nav a:hover::after,
body:not(.customizer-page) .site-nav a:focus-visible::after {
    transform: scaleX(1);
}

body:not(.customizer-page) .site-actions {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 8px;
    direction: ltr;
}

body:not(.customizer-page) .header-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ba-text-soft);
    transition: color var(--ba-transition), background var(--ba-transition), border-color var(--ba-transition), transform var(--ba-transition);
}

body:not(.customizer-page) .header-icon:hover,
body:not(.customizer-page) .header-icon:focus-visible {
    background: rgba(214,179,112,0.08);
    border-color: var(--ba-border);
    color: var(--ba-accent-strong);
    transform: translateY(-1px);
}

body:not(.customizer-page) .header-icon svg,
body:not(.customizer-page) .mobile-bottom-nav svg,
body:not(.customizer-page) .mobile-menu svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
}

body:not(.customizer-page) .header-cart__badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
    padding-inline: 4px;
    border-radius: 999px;
    background: var(--ba-accent);
    color: #121312;
    font-family: var(--ba-latin);
    font-size: 8px;
    font-weight: 800;
}

body:not(.customizer-page) .button,
body:not(.customizer-page) .btn,
body:not(.customizer-page) .shop-hero__cta,
body:not(.customizer-page) .design-cta,
body:not(.customizer-page) .profile-save,
body:not(.customizer-page) .auth-submit,
body:not(.customizer-page) .cart-checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding-inline: 20px;
    border-radius: 999px;
    border: 1px solid rgba(214,179,112,0.4);
    background: linear-gradient(135deg, var(--ba-accent), #f2ddb7);
    color: #121312;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .04em;
    transition: transform var(--ba-transition), box-shadow var(--ba-transition), filter var(--ba-transition);
    box-shadow: 0 12px 28px rgba(214,179,112,0.18);
}

body:not(.customizer-page) .button:hover,
body:not(.customizer-page) .btn:hover,
body:not(.customizer-page) .shop-hero__cta:hover,
body:not(.customizer-page) .design-cta:hover,
body:not(.customizer-page) .profile-save:hover,
body:not(.customizer-page) .auth-submit:hover,
body:not(.customizer-page) .cart-checkout:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 18px 38px rgba(214,179,112,0.2);
}

body:not(.customizer-page) .site-footer {
    border-top: 1px solid var(--ba-border);
    background: rgba(10,15,18,0.94);
}

body:not(.customizer-page) .site-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr .8fr .8fr 1.2fr;
    gap: 28px;
    padding: 34px 0 18px;
}

body:not(.customizer-page) .site-footer__brand-note,
body:not(.customizer-page) .site-footer p,
body:not(.customizer-page) .site-footer a,
body:not(.customizer-page) .site-footer h3 {
    color: var(--ba-text-soft);
}

body:not(.customizer-page) .site-footer__socials {
    display: flex;
    gap: 8px;
    margin-top: 16px;
}

body:not(.customizer-page) .site-footer__socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--ba-border);
    background: rgba(255,255,255,0.02);
}

body:not(.customizer-page) .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0 26px;
    color: var(--ba-muted);
    font-size: 12px;
    border-top: 1px solid var(--ba-white-border);
}

body:not(.customizer-page) .mobile-bottom-nav {
    position: fixed;
    right: 12px;
    left: 12px;
    bottom: 12px;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-height: 66px;
    padding: 8px 10px 10px;
    border: 1px solid var(--ba-border);
    border-radius: 18px;
    background: rgba(13,20,25,0.92);
    box-shadow: var(--ba-shadow-soft);
    backdrop-filter: blur(18px);
}

body:not(.customizer-page) .mobile-bottom-nav a,
body:not(.customizer-page) .mobile-bottom-nav button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 56px;
    color: var(--ba-muted);
    font-size: 10px;
}

body:not(.customizer-page) .mobile-bottom-nav a.is-active,
body:not(.customizer-page) .mobile-bottom-nav a:hover {
    color: var(--ba-accent-strong);
}

body:not(.customizer-page) .mobile-menu__backdrop {
    background: rgba(7,9,11,0.62);
}

body:not(.customizer-page) .mobile-menu__panel {
    background: var(--ba-bg-deep);
    border-left: 1px solid var(--ba-border);
}

body:not(.customizer-page) .mobile-menu__nav a {
    color: var(--ba-text-soft);
    border-bottom: 1px solid var(--ba-white-border);
}

body:not(.customizer-page) .mobile-menu__nav a:hover {
    background: rgba(214,179,112,0.06);
    color: #fff;
}

body:not(.customizer-page) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 700ms var(--ba-ease), transform 700ms var(--ba-ease);
}

body:not(.customizer-page) [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
}

@media (max-width: 980px) {
    body:not(.customizer-page) .site-header__inner {
        grid-template-columns: 48px minmax(0,1fr) auto;
        gap: 12px;
    }

    body:not(.customizer-page) .site-nav {
        display: none;
    }

    body:not(.customizer-page) .site-footer__grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 640px) {
    body:not(.customizer-page) .container,
    body:not(.customizer-page) .shop-shell,
    body:not(.customizer-page) .category-shell,
    body:not(.customizer-page) .product-shell,
    body:not(.customizer-page) .cart-shell {
        width: min(calc(100% - 24px), var(--ba-container));
    }

    body:not(.customizer-page) .site-header__inner {
        min-height: 68px;
    }

    body:not(.customizer-page) .site-logo {
        font-size: 20px;
        letter-spacing: 4px;
    }

    body:not(.customizer-page) .site-footer__grid {
        grid-template-columns: 1fr;
    }

    body:not(.customizer-page) .site-footer__bottom {
        flex-direction: column;
        align-items: flex-start;
    }
}
